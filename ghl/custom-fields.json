      { "name": "UTM Source", "dataType": "TEXT" },
      { "name": "UTM Medium", "dataType": "TEXT" },
      { "name": "UTM Campaign", "dataType": "TEXT" }
    ],
    "alerta_coincidencia": [
      { "name": "Alerta Titulo", "dataType": "TEXT", "_nota": "Variable de la plantilla de WhatsApp" },
      { "name": "Alerta Zona", "dataType": "TEXT" },
      { "name": "Alerta Precio", "dataType": "TEXT" },
      { "name": "Alerta Enlace", "dataType": "TEXT" },
      { "name": "Propiedad Sugerida Ref", "dataType": "TEXT" }
    ]
  }
