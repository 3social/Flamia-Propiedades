{
  "_nota": "Campos de contacto que rellenan los agentes y n8n. dataType según la API de GHL (TEXT, NUMERICAL, MONETORY, SINGLE_OPTIONS, DATE); confirmar con describe_operation antes de crear. Zonas y tipos se guardan como TEXT separado por comas: la fuente real es Supabase.",
  "object": "contact",
  "grupos": {
    "perfil_comprador": [
      { "name": "Idioma Preferido", "dataType": "SINGLE_OPTIONS", "options": ["es", "en"] },
      { "name": "Operacion", "dataType": "SINGLE_OPTIONS", "options": ["Compra", "Renta"] },
      { "name": "Presupuesto Minimo", "dataType": "MONETORY" },
      { "name": "Presupuesto Maximo", "dataType": "MONETORY" },
      { "name": "Moneda", "dataType": "SINGLE_OPTIONS", "options": ["USD", "MXN"] },
      { "name": "Zonas de Interes", "dataType": "TEXT" },
      { "name": "Recamaras Minimas", "dataType": "NUMERICAL" },
      { "name": "Tipos de Propiedad", "dataType": "TEXT" },
      { "name": "Plazo de Decision", "dataType": "SINGLE_OPTIONS", "options": ["Inmediato", "1 a 3 meses", "3 a 6 meses", "Mas de 6 meses", "Solo explorando"] },
      { "name": "Financiamiento", "dataType": "SINGLE_OPTIONS", "options": ["Contado", "Fideicomiso", "Credito", "Por definir"] },
      { "name": "Preferencias", "dataType": "TEXT", "_nota": "Texto libre: 'frente al mar, tranquilo, para rentar'" }
    ],
    "consentimiento": [
      { "name": "Opt-in WhatsApp", "dataType": "SINGLE_OPTIONS", "options": ["Si", "No"] },
      { "name": "Fecha Opt-in", "dataType": "DATE" },
      { "name": "Origen Opt-in", "dataType": "TEXT" }
    ],
    "atribucion": [
